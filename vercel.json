{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "reports/**",
          "spec/**",
          "*.md",
          "manual-verdicts.yaml",
          "issue-map.json"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/server.ts" }
  ]
}
